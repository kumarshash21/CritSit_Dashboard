SF_CLIENT_ID=
SF_CLIENT_SECRET=
SF_INSTANCE_URL=https://yourorg.my.salesforce.com
SF_API_VERSION=v60.0

# Report IDs (View Report -> copy ID from URL)
SF_REPORT_AA=
SF_REPORT_AE=
SF_REPORT_GSTORE=

# Case list view developer name (from filterName= in the list view URL)
SF_CASE_LISTVIEW=IM_Bridge

PORT=4001

# Auto-refresh interval for the browser, in milliseconds
REFRESH_INTERVAL_MS=60000

# Jira (used by the Software Stability page's TEO KPI endpoint)
JIRA_EMAIL=
JIRA_API_TOKEN=

# Path to the Pod-list spreadsheet (one column per pod, cells = account/site
# names) used to build the POD filter on the Software Stability page.
# Defaults to public/Pod_list.xlsx (ships with the repo) if unset.
POD_LIST_PATH=./public/Pod_list.xlsx

# Google Cloud project ID
GCLOUD_PROJECT_ID=

# Path to a GCP service account key JSON file (never commit the actual key file)
GOOGLE_APPLICATION_CREDENTIALS=./gcp-service-account.json
